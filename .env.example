# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public production URL, set automatically by Vercel when configured there
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only personal journal lock. Never expose these with NEXT_PUBLIC_.
LIFE_JOURNAL_PASSWORD=choose-a-personal-password
LIFE_JOURNAL_OWNER_EMAIL=owner@example.com
LIFE_JOURNAL_OWNER_AUTH_PASSWORD=generate-a-long-random-password

# Server-only Google Gemini API key. Never prefix this with NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY=

# Web Push for workout rest notifications (generate with web-push generate-vapid-keys).
NEXT_PUBLIC_WEB_PUSH_VAPID_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:owner@example.com

